# Dynamics 365 Test Harness Configuration
# Copy this file to .env and fill in your values

# Dynamics 365 instance URL (e.g., https://yourorg.crm.dynamics.com)
VITE_DYNAMICS_URL=https://yourorg.crm.dynamics.com

# Azure AD App Registration for OAuth
# Create an app registration in Azure AD with:
# - Redirect URI: http://localhost:5173 (for local dev)
# - API permissions: Dynamics CRM user_impersonation
VITE_AZURE_CLIENT_ID=your-azure-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id
